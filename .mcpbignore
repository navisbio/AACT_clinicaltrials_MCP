# Allowlist: ignore everything, then re-include what the bundle ships.
# A blocklist let local-only files (old builds in dist/, tunnel state in
# server/) slip into the archive.
/*

!/manifest.json
!/README.md
!/LICENSE
!/PRIVACY.md

# The extension runs `uv run --directory ${__dirname} mcp-server-aact`,
# so it needs the project metadata, lockfile and package source.
!/pyproject.toml
!/uv.lock
!/aact_mcp
__pycache__/
